# ==============================================================================
# The Gift Shop - Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Fill in your project keys from the Supabase Dashboard (Settings -> API).
# ==============================================================================

# Supabase Public API (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Server-side only - NEVER expose to client)
# Used for backend webhooks, admin orders fulfillment, and database migrations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=CAD
NEXT_PUBLIC_COUNTRY=Canada

# Optional: Stripe Canadian Payment Gateway (CAD)
STRIPE_SECRET_KEY=sk_test_placeholder_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key
